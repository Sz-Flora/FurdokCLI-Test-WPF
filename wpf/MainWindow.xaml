<Window x:Class="StrandWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StrandWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Vertical">
            <Label Content="Fürdő adatai" FontSize="20" HorizontalAlignment="Center" Margin="0 10 0 0"/>
            <Label Content="Név:" Margin="0 10 0 0"/>
            <TextBox x:Name="nevinput" Margin="0 10 0 0"/>
            <Label Content="Cím:" Margin="0 10 0 0"/>
            <TextBox x:Name="ciminput" Margin="0 10 0 0"/>
            <Label Content="Ár:" Margin="0 10 0 0"/>
            <TextBox x:Name="arinput" Margin="0 10 0 0"/>
            <Label Content="Vízhőfok:" Margin="0 10 0 0"/>
            <TextBox x:Name="hofokinput" Margin="0 10 0 0"/>
            <ProgressBar x:Name="progress" Maximum="100" Minimum="0" Height="20"/>
            <Button Content="Mentés" Margin="10" Padding="5" Click="ment"/>
        </StackPanel>
        <DataGrid Grid.Column="1" d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="datagrid" SelectionChanged="kivalasztott"/>

    </Grid>
</Window>
